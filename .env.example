# Lab Assistant Slack Bot — environment variables
# Copy this file to .env and fill in your tokens.
# .env is in .gitignore and never committed.

# Slack Bot Token (xoxb-...)
# From: https://api.slack.com/apps → your app → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Slack App-Level Token (xapp-...) — needed for Socket Mode
# From: https://api.slack.com/apps → your app → Basic Information → App-Level Tokens
# Required scopes: connections:write
SLACK_APP_TOKEN=xapp-your-app-level-token-here

# Scheduler API base URL (default: http://127.0.0.1:8766)
SCHEDULER_API=http://127.0.0.1:8766

# OpenAI API Key — enables GPT-4o-mini for cage card parsing + NL commands
# Get from: https://platform.openai.com/api-keys
# Optional: bot falls back to rule-based parser if not set
OPENAI_API_KEY=sk-your-openai-key-here
